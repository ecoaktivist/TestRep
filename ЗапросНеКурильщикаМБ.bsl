	РегистрСведений.афлИсторияРасчетовДебиторскойЗадолжностиПоКонтрагентам.СрезПоследних(
			,
			Контрагент В
				(ВЫБРАТЬ
					ВТ_ОтборЗНОВСтатусеНеЧерновик.Контрагент КАК ЗаявкаНаОплатуКонтрагент
				ИЗ
					ВТ_ОтборЗНОВСтатусеНеЧерновик КАК ВТ_ОтборЗНОВСтатусеНеЧерновик)) КАК афлИсторияРасчетовДебиторскойЗадолжностиПоКонтрагентамСрезПоследних
ГДЕ
	афлИсторияРасчетовДебиторскойЗадолжностиПоКонтрагентамСрезПоследних.Заблокирован = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОтборЗНОВСтатусеНеЧерновик.Период КАК Период,
	ВТ_ОтборЗНОВСтатусеНеЧерновик.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	ВТ_ОтборЗНОВСтатусеНеЧерновик.Контрагент КАК Контрагент,
	ВТ_ОтборЗНОВСтатусеНеЧерновик.БлокировкаДЗ КАК БлокировкаДЗ,
	ВТ_ОтборЗНОВСтатусеНеЧерновик.БлокировкаАвансирования КАК БлокировкаАвансирования
ПОМЕСТИТЬ ВТ_ОтборНеРазблокированныеКонтрагенты
ИЗ
	ВТ_ОтборЗНОВСтатусеНеЧерновик КАК ВТ_ОтборЗНОВСтатусеНеЧерновик
ГДЕ
	ВТ_ОтборЗНОВСтатусеНеЧерновик.Контрагент В
			(ВЫБРАТЬ
				ВТ_РазблокированныеКонтрагенты.Контрагент КАК Контрагент
			ИЗ
				ВТ_РазблокированныеКонтрагенты КАК ВТ_РазблокированныеКонтрагенты)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОтборЗНО.Период КАК Период,
	ВТ_ОтборЗНО.ЗаявкаНаОплату КАК ЗаявкаНаОплату,
	ВТ_ОтборЗНО.Контрагент КАК Контрагент,
	ВТ_ОтборЗНО.БлокировкаДЗ КАК БлокировкаДЗ,
	ВТ_ОтборЗНО.БлокировкаАвансирования КАК БлокировкаАвансирования
ИЗ
	ВТ_ОтборЗНО КАК ВТ_ОтборЗНО
ГДЕ
	НЕ ВТ_ОтборЗНО.ЗаявкаНаОплату В
				(ВЫБРАТЬ
					ВТ_ОтборНеРазблокированныеКонтрагенты.ЗаявкаНаОплату КАК ЗаявкаНаОплату
				ИЗ
					ВТ_ОтборНеРазблокированныеКонтрагенты КАК ВТ_ОтборНеРазблокированныеКонтрагенты);

Процедура ОбновитьЗаписьЗаблокированнойЗНОПоКонтролюДЗ(ДанныеЗаполнения, КонтрольДЗПройден) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПолучитьЗаблокированныеЗНО();
	
	Запрос.УстановитьПараметр("ЗаявкаНаОплату", ДанныеЗаполнения.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		НаборЗаписей = РегистрыСведений.афлЗаблокированныеЗНО.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.ЗаявкаНаОплату.Установить(Выборка.ЗаявкаНаОплату);
		
		НаборЗаписей.Прочитать();
		
		НаборЗаписей[0].ДатаПроверкиЗНО = ТекущаяДатаСеанса();
		НаборЗаписей[0].СуммаЗНОВРублях = ПолучитьСуммуЗНОВРублях(
											ДанныеЗаполнения.ВалютаВзаиморасчетов, ДанныеЗаполнения.СуммаДокумента);
		НаборЗаписей[0].БлокировкаДЗ 	= Не КонтрольДЗПройден;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
КонецПроцедуры